{
  "name": "latex-collab-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "pretest": "pnpm --filter \"./packages/*\" build && pnpm --filter @latex-collab/jobs build",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "lint": "eslint . && node --experimental-strip-types scripts/check-workspace.ts",
    "format": "prettier --write apps packages scripts tests *.json *.ts *.js infra .github .prettierrc.json",
    "format:check": "prettier --check apps packages scripts tests *.json *.ts *.js infra .github .prettierrc.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter @latex-collab/collab build && pnpm --filter @latex-collab/jobs build && pnpm --filter @latex-collab/api build && pnpm --filter @latex-collab/web build && tsc -p tsconfig.build.json",
    "dev": "pnpm --filter \"./packages/*\" build && pnpm --filter @latex-collab/collab build && pnpm --filter @latex-collab/jobs build && tsx scripts/dev.ts",
    "infra:up": "pnpm --filter \"./packages/*\" build && docker compose --env-file .env -f infra/docker-compose.yml up -d --wait --build && node scripts/init-storage.mjs",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "env:init": "node scripts/init-env.mjs",
    "security:check": "node scripts/check-secrets.mjs && pnpm audit --audit-level high",
    "artifacts:check": "node scripts/check-artifacts.mjs",
    "smoke": "tsx infra/scripts/smoke.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@latex-collab/config": "workspace:*",
    "@latex-collab/contracts": "workspace:*",
    "@latex-collab/db": "workspace:*",
    "@latex-collab/editor": "workspace:*",
    "@latex-collab/latex": "workspace:*",
    "@latex-collab/storage": "workspace:*",
    "@latex-collab/test-utils": "workspace:*",
    "@playwright/test": "1.64.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "argon2": "0.45.1",
    "drizzle-orm": "^0.45.4",
    "eslint": "10.12.0",
    "fastify": "5.12.5",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tsx": "4.23.15",
    "turbo": "2.11.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@types/ws": "^8.18.2",
    "ws": "^8.22.0",
    "y-codemirror.next": "0.3.5",
    "yjs": "13.6.27"
  }
}
