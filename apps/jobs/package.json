{
  "name": "@latex-collab/jobs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./sync/github-pull": {
      "types": "./src/sync/github-pull.ts",
      "default": "./dist/sync/github-pull.js"
    },
    "./sync/apply-changes": {
      "types": "./src/sync/apply-changes.ts",
      "default": "./dist/sync/apply-changes.js"
    },
    "./sync/github-push": {
      "types": "./src/sync/github-push.ts",
      "default": "./dist/sync/github-push.js"
    }
  },
  "dependencies": {
    "@latex-collab/config": "workspace:*",
    "@latex-collab/contracts": "workspace:*",
    "@latex-collab/db": "workspace:*",
    "@latex-collab/latex": "workspace:*",
    "@latex-collab/storage": "workspace:*",
    "yauzl": "3.4.0",
    "yjs": "13.6.27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "storage:gc": "node --env-file=../../.env --import tsx src/main.ts --once",
    "imports:validate": "node --env-file=../../.env --import tsx src/imports/worker.ts --once",
    "imports:apply": "node --env-file=../../.env --import tsx src/main.ts imports:apply --once"
  },
  "devDependencies": {
    "@types/yauzl": "3.4.0"
  }
}
